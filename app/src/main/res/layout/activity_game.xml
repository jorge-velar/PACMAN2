<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:padding="6dp"/>

    <FrameLayout
        android:id="@+id/Frame2"
        android:layout_width="match_parent"
        android:layout_height="559dp"
        android:alpha="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_above="@+id/bottomBar">


        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="562dp"
            android:layout_above="@+id/bottomBar"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fondo2" />
    </FrameLayout>
    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>


    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingBottom="10dp"
    android:paddingTop="10dp"
    android:layout_alignParentBottom="true"
    android:id="@+id/bottomBar"
    android:background="#4A619D">
        <ImageButton
        android:id="@+id/topBtn"
        android:layout_width="80dp"
        android:background="@drawable/borde_botones"
        android:contentDescription="arriba"
        android:src="@drawable/arrow_up"
        android:layout_height="50dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageButton
        android:id="@+id/leftBtn"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:contentDescription="izquierda"
        android:src="@drawable/arrow_left"
        android:background="@drawable/borde_botones"
        android:layout_marginEnd="80dp"/>
        <ImageButton
        android:id="@+id/rightBtn"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:src="@drawable/arrow_right"
        android:contentDescription="derecha"

        android:background="@drawable/borde_botones"

        />
    </LinearLayout>
        <ImageButton
        android:id="@+id/bottomBtn"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:contentDescription="abajo"
        android:src="@drawable/arrow_down"
        android:background="@drawable/borde_botones"/>


    </LinearLayout>

</RelativeLayout>